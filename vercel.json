{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "mkdir -p vazio && echo ok > vazio/.vazio",
  "installCommand": "npm ci --omit=dev --no-audit --no-fund",
  "outputDirectory": "vazio",
  "regions": ["gru1"],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{dist,public,site,demo,node_modules}/**",
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.mjs" }]
}
